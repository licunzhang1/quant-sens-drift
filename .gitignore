# ---- Python ----
__pycache__/
*.py[cod]
*.so
.ipynb_checkpoints/
.venv/
venv/
env/

# ---- 实验产物：权重与日志不入库 ----
# 权重可重新训练得到，入库会让仓库迅速膨胀；复现方式见 README。
*.pt
*.pth
*.ckpt
*.onnx
experiments/logs/
.pipwork/
.tmp/

# ---- torch / 编译缓存 ----
# torch 会在当前工作目录生成 torchinductor_<本机用户名> 缓存目录，
# 目录名里带用户名，提交前务必确认它没被加进来。
torchinductor_*/
torch_compile_debug/
*.lock

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 编辑器 ----
.vscode/
.idea/
*.swp

# ---- Python ----
__pycache__/
*.py[cod]
*.so
.ipynb_checkpoints/
.venv/
venv/
env/

# ---- Experiment artifacts: weights and logs stay out of the repository ----
# Weights can be regenerated by training; committing them makes the repository
# grow without bound. See the README for how to reproduce them.
*.pt
*.pth
*.ckpt
*.onnx
experiments/logs/
.pipwork/
.tmp/

# ---- torch / compilation caches ----
# torch writes a torchinductor_<local username> cache directory into the current
# working directory. The directory name carries the username, so always check
# that it has not been staged before committing.
torchinductor_*/
torch_compile_debug/
*.lock

# ---- operating system ----
.DS_Store
Thumbs.db
desktop.ini

# ---- editors ----
.vscode/
.idea/
*.swp
